--- a/src/desktop/view/Subsurface.cpp
+++ b/src/desktop/view/Subsurface.cpp
@@ -207,6 +207,26 @@
         m_lastSize     = m_wlSurface->resource()->m_current.size;
         m_lastPosition = m_subsurface->m_position;
     }
+
+    // Wine Wayland presents Vulkan frames on a subsurface, without committing
+    // the toplevel. Schedule tearing for the solitary scanout surface here too.
+    const auto PWINDOW  = m_windowParent.lock();
+    const auto PMONITOR = PWINDOW ? PWINDOW->m_monitor.lock() : nullptr;
+    const auto PSURFACE = m_wlSurface->resource();
+    if (!PMONITOR || PMONITOR->m_solitaryClient.lock() != PWINDOW || !PWINDOW->canBeTorn() || !PMONITOR->m_tearingState.canTear || PWINDOW->getSolitaryResource() != PSURFACE ||
+        !PSURFACE->m_current.texture || (PMONITOR->isTearingBlocked(true) & ~Monitor::CMonitor::TC_NOT_TORN))
+        return;
+
+    const CRegion DAMAGE = PSURFACE->m_current.accumulateBufferDamage();
+    if (DAMAGE.empty())
+        return;
+
+    if (PMONITOR->m_tearingState.busy)
+        PMONITOR->m_tearingState.frameScheduledWhileBusy = true;
+    else {
+        PMONITOR->m_tearingState.nextRenderTorn = true;
+        g_pHyprRenderer->renderMonitor(PMONITOR);
+    }
 }
 
