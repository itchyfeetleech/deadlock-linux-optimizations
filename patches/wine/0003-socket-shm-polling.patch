+/* Read the socket state published by the server in the session shared mapping.
+ * Returns FALSE if it is not available. */
+static BOOL get_sock_shm_state( HANDLE handle, sock_shm_t *state )
+{
+    const shared_object_t *object;
+    object_id_t id, object_id;
+    unsigned int spins = 0;
+    LONG64 seq;
+
+    if (!(object = server_get_sock_shm( handle, &id ))) return FALSE;
+    for (;;)
+    {
+        while ((seq = ReadAcquire64( &object->seq )) & 1)
+        {
+            if (++spins > 4096) return FALSE;
+            YieldProcessor();
+        }
+        object_id = object->id;
+        state->pending_events = object->shm.sock.pending_events;
+        state->reported_events = object->shm.sock.reported_events;
+        state->mask = object->shm.sock.mask;
+        state->flags = object->shm.sock.flags;
+        __atomic_thread_fence( __ATOMIC_ACQUIRE );
+        if (ReadNoFence64( &object->seq ) == seq) break;
+    }
+    return object_id == id;
+}
