+/* Publish the state the client fast paths depend on. This must happen before
+ * anything that lets another thread observe a change, i.e. before setting the
+ * event object or replying to the request. */
+static void sock_publish( struct sock *sock )
+{
+    sock_shm_t *shm = sock->shm;
+    unsigned int flags = 0;
+
+    if (!shm) return;
+
+    if (sock->nonblocking) flags |= SOCK_SHM_NONBLOCKING;
+    if (sock->type == WS_SOCK_DGRAM) flags |= SOCK_SHM_DGRAM;
+    if (sock->bound) flags |= SOCK_SHM_BOUND;
+    if (async_queued( &sock->read_q )) flags |= SOCK_SHM_READ_QUEUED;
+    if (async_queued( &sock->write_q )) flags |= SOCK_SHM_WRITE_QUEUED;
+    if (sock->rd_shutdown) flags |= SOCK_SHM_RD_SHUTDOWN;
+    if (sock->wr_shutdown || sock->wr_shutdown_pending) flags |= SOCK_SHM_WR_SHUTDOWN;
+    if (sock->reset || sock->aborted) flags |= SOCK_SHM_ERROR;
+    if (sock->window) flags |= SOCK_SHM_MSG_SELECT;
+    if (sock->proto == WS_IPPROTO_ICMP || sock->proto == WS_IPPROTO_ICMPV6) flags |= SOCK_SHM_ICMP;
+
+    if (shm->pending_events == sock->pending_events && shm->reported_events == sock->reported_events &&
+        shm->mask == sock->mask && shm->flags == flags)
+        return;
+
+    SHARED_WRITE_BEGIN( shm, sock_shm_t )
+    {
+        shared->pending_events = sock->pending_events;
+        shared->reported_events = sock->reported_events;
+        shared->mask = sock->mask;
+        shared->flags = flags;
+    }
+    SHARED_WRITE_END;
+}
