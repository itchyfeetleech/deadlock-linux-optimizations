+static const shared_object_t *find_session_object( mem_size_t offset )
+{
+    static const WCHAR nameW[] = {'\\','K','e','r','n','e','l','O','b','j','e','c','t','s','\\',
+                                  '_','_','w','i','n','e','_','s','e','s','s','i','o','n',0};
+    const SIZE_T size = sizeof(shared_object_t);
+    struct session_block *block;
+    const shared_object_t *ret = NULL;
+    UNICODE_STRING name;
+    OBJECT_ATTRIBUTES attr;
+    LARGE_INTEGER off;
+    HANDLE section;
+    sigset_t sigset;
+
+    if (offset + size < offset) return NULL;
+
+    server_enter_uninterrupted_section( &session_lock, &sigset );
+    LIST_FOR_EACH_ENTRY( block, &session_blocks, struct session_block, entry )
+    {
+        if (block->offset <= offset && offset + size <= block->offset + block->size)
+        {
+            ret = (const shared_object_t *)(block->data + offset - block->offset);
+            goto done;
+        }
+    }
+
+    if (!(block = calloc( 1, sizeof(*block) ))) goto done;
+    init_unicode_string( &name, nameW );
+    InitializeObjectAttributes( &attr, &name, 0, NULL, NULL );
+    off.QuadPart = offset & ~(SIZE_T)0xffff;
+    if (!NtOpenSection( &section, SECTION_MAP_READ, &attr ))
+    {
+        if (!NtMapViewOfSection( section, GetCurrentProcess(), (void **)&block->data, 0, 0,
+                                 &off, &block->size, ViewUnmap, 0, PAGE_READONLY ))
+        {
+            block->offset = off.QuadPart;
+            if (block->offset <= offset && offset + size <= block->offset + block->size)
+            {
+                list_add_tail( &session_blocks, &block->entry );
+                ret = (const shared_object_t *)(block->data + offset - block->offset);
+                block = NULL;
+            }
+            else NtUnmapViewOfSection( GetCurrentProcess(), (void *)block->data );
+        }
+        NtClose( section );
+    }
+    free( block );
+
+done:
+    server_leave_uninterrupted_section( &session_lock, &sigset );
+    return ret;
+}
