+/* mapped blocks of the session shared mapping */
+struct session_block
+{
+    struct list entry;
+    const char *data;
+    SIZE_T      offset;
+    SIZE_T      size;
+};
+
+static pthread_mutex_t session_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct list session_blocks = LIST_INIT( session_blocks );
